tenancy_ocid             = "ocid1.tenancy.oc1..replace-me"
compartment_ocid         = "ocid1.compartment.oc1..replace-me"
region                   = "ap-mumbai-1"
object_storage_namespace = "replace-me"
instance_ocids = [
  "ocid1.instance.oc1..replace-vm1",
  "ocid1.instance.oc1..replace-vm2",
]
notification_email = "ops@example.com"
state_version_retention_days = 30
# Customer-managed OCI Vault key for Terraform-state encryption at rest.
# The key must already exist (it is not created by this root) in the same
# region as the buckets — the variable validation enforces this — and the
# operator applying this root needs permission to use it. Bootstrap adds the
# required Object Storage service policy automatically (hyphenated service
# subject objectstorage-<region>, pinned to the exact key OCID).
state_bucket_kms_key_id = "ocid1.key.oc1..replace-me"
# The compartment holding the Vault key. Use the tenancy OCID for the root
# compartment (where the existing rust-api-secrets vault lives) or a child
# compartment OCID; the policy location form is derived automatically.
kms_key_compartment_ocid = "ocid1.tenancy.oc1..replace-me"

# Create separate statements from the OCI identity-domain federation setup.
# Both workload identities must be bound to the expected repository/environment
# in the trust configuration and constrain request.principal attributes here.
# The plan identity may read infrastructure and manage only state/lock objects.
github_plan_oidc_policy_statements = [
  "Allow any-user to inspect compartments in compartment id ocid1.compartment.oc1..replace-me where request.principal.type = 'workload'",
]

# The apply identity receives only the explicit EventForge write permissions
# required by this Terraform configuration.
github_apply_oidc_policy_statements = [
  "Allow any-user to inspect compartments in compartment id ocid1.compartment.oc1..replace-me where request.principal.type = 'workload'",
]

