# M1-LOCAL deployment configuration — NON-SECRET coordinates only.
# Sourced by scripts/local/lib-m1.sh. No credentials, private-key paths,
# or token values may ever be added to this file (guards enforce it).

# Pinned deployment executor (checksum-verified Terraform 1.12.2 workstation install).
M1_TERRAFORM_BIN="${M1_TERRAFORM_BIN:-/Users/eswr/tools/terraform/1.12.2/terraform}"
M1_TERRAFORM_VERSION="1.12.2"

# OCI API-key authentication (operator workstation; never Resource Principal).
M1_OCI_PROFILE="${M1_OCI_PROFILE:-DEFAULT}"
M1_OCI_REGION="${M1_OCI_REGION:-ap-hyderabad-1}"
M1_OCI_NAMESPACE="${M1_OCI_NAMESPACE:-axrq1dasyz3y}"
M1_TF_STATE_BUCKET="${M1_TF_STATE_BUCKET:-eventforge-tfstate-prod}"

# Expected remote state keys (exact ownership).
M1_BOOTSTRAP_KEY="bootstrap/terraform.tfstate"
M1_PLATFORM_KEY="platform/terraform.tfstate"
M1_FRONTEND_KEY="frontend/terraform.tfstate"
M1_IAM_KEY="iam/terraform.tfstate"

# Accepted bootstrap state lineage (Phase 0 baseline record).
M1_BOOTSTRAP_LINEAGE="${M1_BOOTSTRAP_LINEAGE:-a79177dd-2c02-084e-ddf6-29f346b2fa78}"
M1_BOOTSTRAP_ADDRESSES=8

# State-bucket CMK (must stay ENABLED).
M1_EXPECTED_KMS_KEY_ID="ocid1.key.oc1.ap-hyderabad-1.gfvn7rbsaab4m.abuhsljrfq3gaqtpyejt5gfe4cra2fa6hhzuyqicb6vhevlspuujd3srbcyq"

# Protected evidence root — OUTSIDE the repository, mode 0700.
M1_EVIDENCE_ROOT="${M1_EVIDENCE_ROOT:-/Users/eswr/secure/evidence}"

# Safe-plan policy pair used for every platform plan. The default is the
# strict M1-LOCAL general policy and MUST stay the default; the only
# sanctioned override is the scope-A NSG-association policy
# (scripts/ci/platform-safe-plan-scope-a-policy.json) selected explicitly by
# the scope-A gate, which additionally runs the attribute-level checker. The
# selected policy is recorded in the plan metadata consumed by the apply gate.
M1_SAFE_PLAN_SCRIPT="scripts/ci/assert-safe-plan.sh"
M1_SAFE_PLAN_POLICY="${M1_SAFE_PLAN_POLICY:-scripts/ci/platform-safe-plan-policy.json}"

# IAM execution guard (infra/iam — MYSQL-NSG-IAM gate). The plan checker
# enforces the exact two-policy contract in scripts/ci/iam-plan-contract.json;
# the apply requires a written MYSQL-NSG-IAM approval record (never env-only).
M1_IAM_PLAN_CONTRACT="scripts/ci/iam-plan-contract.json"
M1_IAM_PLAN_CHECKER="scripts/ci/assert-iam-plan.sh"

# Dedicated MYSQL-NSG-RETEST safe-plan policy (one allow entry: the MySQL DB
# system nsg_ids update with exact before/after values). A plan reviewed
# against THIS policy is applied only under the separate MYSQL-NSG-RETEST
# approval gate — never under a general PLATFORM-APPLY record.
M1_MYSQL_RETEST_POLICY="scripts/ci/platform-safe-plan-mysql-retest-policy.json"
