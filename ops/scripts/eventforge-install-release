#!/usr/bin/env bash
# -E (errtrace) is required for the ERR traps below: without it the trap does
# not fire for failures inside functions (e.g. a failed asset download).
set -Eeuo pipefail

if [[ $# -ne 1 || ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "usage: eventforge-install-release <immutable-release-tag>" >&2
  exit 64
fi

version="$1"
: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required in /etc/eventforge/release.env}"

# EVENTFORGE_RELEASE_ROOT exists for offline dry-run tests only; production
# always uses the default.
release_root="${EVENTFORGE_RELEASE_ROOT:-/opt/eventforge}"
release_dir="${release_root}/releases/${version}"
api_name="eventforge-api-${version}"
worker_name="eventforge-worker-${version}"
checksum_name="SHA256SUMS"
old_release="$(readlink -f "${release_root}/current" 2>/dev/null || true)"

if [[ -d "$release_dir" ]]; then
  echo "release already exists: $release_dir" >&2
  exit 1
fi

own_args=()
if [[ "$(id -u)" -eq 0 ]]; then
  own_args=(-o root -g eventforge)
fi
install -d "${own_args[@]}" -m 0750 "${release_root}/releases" "$release_dir"

auth_args=()
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  auth_args=(-H "Authorization: Bearer ${GITHUB_TOKEN}")
fi

# Download/staging phase: on any failure discard the partial release directory
# entirely, so a retry of a fixed version cannot collide with "already exists".
trap 'rm -rf "$release_dir"' ERR

release_json="$(curl --fail --silent --show-error --location "${auth_args[@]}" \
  "https://api.github.com/repos/${GITHUB_REPOSITORY}/releases/tags/${version}")"
download_asset() {
  local asset="$1"
  local url
  url="$(jq -er --arg name "$asset" '.assets[] | select(.name == $name) | .browser_download_url' <<<"$release_json")"
  curl --fail --silent --show-error --location "${auth_args[@]}" --output "${release_dir}/${asset}" "$url"
}

download_asset "$api_name"
download_asset "$worker_name"
download_asset "$checksum_name"

# The published manifest contains exactly the two binaries of the release
# (release.yml generates SHA256SUMS from exactly those files). Everything is
# verified strictly: an entry count mismatch, a missing binary entry, or a
# malformed line must all reject the release — BSD shasum -c merely warns on
# malformed lines, so the count is checked explicitly.
(
  cd "$release_dir"
  manifest_lines="$(grep -c . "$checksum_name")"
  if [[ "$manifest_lines" -ne 2 ]]; then
    echo "SHA256SUMS must contain exactly the two release binaries (found ${manifest_lines} entries)" >&2
    exit 1
  fi
  grep -qE "(^|[^A-Za-z0-9._-])${api_name}([[:space:]]|$)" "$checksum_name"
  grep -qE "(^|[^A-Za-z0-9._-])${worker_name}([[:space:]]|$)" "$checksum_name"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum --check --strict "$checksum_name"
  else
    shasum -a 256 --check "$checksum_name"
  fi
)
chmod 0750 "${release_dir}/${api_name}" "${release_dir}/${worker_name}"

# Replace the current symlink by rename(2), never by unlink+recreate: a
# non-atomic switch leaves a window where the current symlink is missing and
# a service restart would fail. GNU mv needs -T so a symlink pointing at a
# directory is not followed; BSD mv (the macOS test fixtures) has no -T and
# its plain -f FOLLOWS a symlink-to-directory destination, so there the swap
# is done with perl's rename(2) — the same atomic call, no following.
switch_current_symlink() {
  local target="$1" link="$2" tmp
  tmp="${link}.incoming.$$"
  ln -sfn "$target" "$tmp"
  if mv -Tf "$tmp" "$link" 2>/dev/null; then
    return 0
  fi
  perl -e 'rename($ARGV[0], $ARGV[1]) or die "rename failed: $!"' "$tmp" "$link"
}

switch_current_symlink "$release_dir" "${release_root}/current"

rollback() {
  local status="$1"
  if [[ -n "$old_release" && -d "$old_release" ]]; then
    switch_current_symlink "$old_release" "${release_root}/current"
    systemctl restart eventforge-api.service eventforge-worker.service || true
    echo "release ${version} failed; restored previous release" >&2
  else
    echo "release ${version} failed; no previous release to restore" >&2
  fi
  exit "$status"
}
trap 'rollback "$?"' ERR

# Poll windows are overridable only for offline dry-run tests; production uses
# the defaults (18 polls, 5 s apart ≈ 90 s budget).
readyz_polls="${EVENTFORGE_READYZ_POLLS:-18}"
poll_interval="${EVENTFORGE_POLL_INTERVAL:-5}"

systemctl restart eventforge-api.service
for (( poll = 0; poll < readyz_polls; poll++ )); do
  if curl --fail --silent --show-error --max-time 2 http://127.0.0.1:8080/readyz >/dev/null; then
    systemctl restart eventforge-worker.service
    trap - ERR
    echo "release ${version} installed successfully"
    exit 0
  fi
  sleep "$poll_interval"
done

# Health-check exhaustion is a rollback case too: exit through the trap
# instead of exiting directly, which would leave the broken release current.
echo "API never became ready" >&2
false
